{
  "name": "@tazkartak/mobile",
  "version": "1.0.0",
  "description": "Tazkartak React Native mobile app",
  "main": "index.js",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "analyze:bundle": "node bundle-analyzer.js",
    "bundle:size": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res/ && du -sh android/app/src/main/assets/index.android.bundle",
    "type-check": "tsc --noEmit",
    "clean": "react-native clean",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:ios": "cd ios && xcodebuild -workspace Tazkartak.xcworkspace -scheme Tazkartak -configuration Release -destination generic/platform=iOS -archivePath Tazkartak.xcarchive archive",
    "pod-install": "cd ios && pod install"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-native": "0.74.5",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/stack": "^6.3.20",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/drawer": "^6.6.6",
    "@reduxjs/toolkit": "^2.0.1",
    "react-redux": "^9.0.4",
    "redux-persist": "^6.0.0",
    "axios": "^1.6.2",
    "@tanstack/react-query": "^5.8.4",
    "react-native-reanimated": "^3.6.2",
    "react-native-gesture-handler": "^2.14.1",
    "react-native-svg": "^14.1.0",
    "@react-native-async-storage/async-storage": "^1.21.0",
    "react-native-keychain": "^8.1.3",
    "@react-native-community/netinfo": "^11.2.1",
    "react-native-biometrics": "^3.0.1",
    "react-native-camera": "^4.2.1",
    "react-native-vision-camera": "^3.6.17",
    "react-native-qrcode-svg": "^6.2.0",
    "react-native-maps": "^1.8.0",
    "react-native-image-picker": "^7.0.3",
    "@react-native-community/datetimepicker": "^7.6.2",
    "react-native-fast-image": "^8.6.3",
    "@shopify/flash-list": "^1.6.3",
    "react-native-screens": "^3.29.0",
    "react-native-safe-area-context": "^4.8.2",
    "react-native-vector-icons": "^10.0.3",
    "react-native-paper": "^5.11.6",
    "react-native-toast-message": "^2.2.0",
    "react-native-device-info": "^10.11.0",
    "react-native-background-fetch": "^4.2.3",
    "react-native-push-notification": "^8.1.1",
    "@react-native-firebase/app": "^19.0.1",
    "@react-native-firebase/messaging": "^19.0.1",
    "react-native-wallet-manager": "^1.0.0",
    "react-native-haptic-feedback": "^2.2.0",
    "react-native-permissions": "^4.1.1",
    "react-native-config": "^1.5.1",
    "react-native-splash-screen": "^3.3.0",
    "react-native-orientation-locker": "^1.5.0",
    "react-native-share": "^10.0.2",
    "react-native-fs": "^2.20.0",
    "react-native-crypto-js": "^1.0.0",
    "crypto-js": "^4.2.0",
    "vision-camera-code-scanner": "^0.2.0",
    "react-native-geolocation-service": "^5.3.0",
    "react-native-crypto": "^2.2.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-modal": "^13.0.1",
    "react-native-loading-spinner-overlay": "^3.0.1",
    "react-native-skeleton-placeholder": "^5.2.4",
    "react-native-charts-wrapper": "^0.6.0",
    "victory-native": "^36.6.12",
    "socket.io-client": "^4.7.4",
    "date-fns": "^2.30.0",
    "lodash": "^4.17.21",
    "yup": "^1.4.0",
    "react-hook-form": "^7.48.0",
    "@hookform/resolvers": "^3.3.0",
    "react-native-webview": "^13.6.4",
    "@react-native-async-storage/async-storage": "^1.21.0",
    "react-native-paymob": "^1.0.0",
    "react-native-fawry": "^1.0.0",
    "react-native-ssl-pinning": "^1.6.2",
    "react-native-encrypted-storage": "^4.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native/eslint-config": "^0.74.0",
    "@react-native/metro-config": "^0.74.0",
    "@react-native/typescript-config": "^0.74.0",
    "@types/react": "^18.2.6",
    "@types/react-test-renderer": "^18.0.0",
    "@types/lodash": "^4.14.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "babel-jest": "^29.6.3",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "metro-react-native-babel-preset": "0.76.8",
    "prettier": "^2.4.1",
    "react-test-renderer": "18.2.0",
    "typescript": "5.0.4",
    "@testing-library/react-native": "^12.4.2",
    "@testing-library/jest-native": "^5.4.3",
    "detox": "^20.17.2",
    "msw": "^2.0.8"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "jest": {
    "preset": "react-native",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(react-native|@react-native|@react-navigation|@reduxjs|react-redux|@tanstack)/)"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/src/tests/setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/android/",
      "/ios/"
    ]
  },
  "detox": {
    "testRunner": {
      "args": {
        "config": "e2e/config.json",
        "testNamePattern": ".*\\.e2e\\.js$"
      },
      "jest": {
        "setupFilesAfterEnv": [
          "<rootDir>/e2e/init.js"
        ]
      }
    },
    "apps": {
      "android.debug": {
        "type": "android.apk",
        "binaryPath": "android/app/build/outputs/apk/debug/app-debug.apk",
        "build": "cd android && ./gradlew assembleDebug assembleAndroidTest -DtestBuildType=debug"
      },
      "ios.debug": {
        "type": "ios.app",
        "binaryPath": "ios/build/Build/Products/Debug-iphonesimulator/Tazkartak.app",
        "build": "cd ios && xcodebuild -workspace Tazkartak.xcworkspace -scheme Tazkartak -configuration Debug -destination 'platform=iOS Simulator,name=iPhone 15' -derivedDataPath ios/build"
      }
    },
    "devices": {
      "simulator": {
        "type": "ios.simulator",
        "device": {
          "type": "iPhone 15"
        }
      },
      "emulator": {
        "type": "android.emulator",
        "device": {
          "avdName": "Pixel_7_API_34"
        }
      }
    },
    "configurations": {
      "ios.sim.debug": {
        "binaryPath": "ios/build/Build/Products/Debug-iphonesimulator/Tazkartak.app",
        "build": "cd ios && xcodebuild -workspace Tazkartak.xcworkspace -scheme Tazkartak -configuration Debug -destination 'platform=iOS Simulator,name=iPhone 15' -derivedDataPath ios/build",
        "type": "ios.simulator",
        "device": {
          "type": "iPhone 15"
        }
      },
      "android.emu.debug": {
        "binaryPath": "android/app/build/outputs/apk/debug/app-debug.apk",
        "build": "cd android && ./gradlew assembleDebug assembleAndroidTest -DtestBuildType=debug",
        "type": "android.emulator",
        "device": {
          "avdName": "Pixel_7_API_34"
        }
      }
    }
  }
}
